# Copy to .env (never commit .env). Every value here is free; see docs/free-services.md
# in the Siliconia docs repo. Dummy values only.

APP_MODE=local
APP_VERSION=dev
LOG_LEVEL=info

# Database and cache (containers on the internal Docker network)
POSTGRES_USER=siliconia
POSTGRES_PASSWORD=siliconia
POSTGRES_DB=siliconia
DATABASE_URL=postgres://siliconia:siliconia@postgres:5432/siliconia?sslmode=disable
REDIS_URL=redis://redis:6379/0

# Web origin(s) allowed to call the API directly (Caddy serves one origin)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
RATELIMIT_GUEST_PER_MINUTE=120

# Sign-in (T1.1-T1.3). Local dev keys are built in; on the VM generate each with
#   openssl rand -base64 32
AUTH_SIGNING_KEY=
OTP_PEPPER=
ENCRYPTION_MASTER_KEY=
# true once the site is served over HTTPS
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8080
# Optional "Continue with Google" (free OAuth client). Leave empty to hide it.
# Authorised redirect URI: <PUBLIC_BASE_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Providers: free simulators only in this build
PROVIDER_SMS=sim
PROVIDER_WHATSAPP=sim
PROVIDER_EMAIL=log
SIM_NOTIFY_URL=http://sim-notify:9005
PROVIDER_KYC=sim
SIM_KYC_URL=http://sim-kyc:9004

# Test inbox (prototype only)
FEATURE_TEST_INBOX=true
TEST_INBOX_PASSWORD=change-me-tester

# Object storage for product images (T1.6): the SeaweedFS container, or
# Cloudflare R2's free tier (STORAGE_ENDPOINT=<account>.r2.cloudflarestorage.com,
# STORAGE_USE_SSL=true, STORAGE_REGION=auto). Use long random keys on the VM.
STORAGE_ENDPOINT=seaweedfs:8333
STORAGE_ACCESS_KEY=siliconics-local
STORAGE_SECRET_KEY=change-me-local-storage-key
STORAGE_BUCKET_MEDIA=siliconics-media
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# Caddy: ":80" locally; your free subdomain on the VM, e.g. siliconics.duckdns.org
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Where the Next.js app runs: `npm run dev` on the host locally, or the web container on the VM
WEB_UPSTREAM=host.docker.internal:3000
